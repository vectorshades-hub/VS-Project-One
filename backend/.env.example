# Copy this file to .env and fill in the values.

PORT=5005
HOST=0.0.0.0

MONGODB_URI=mongodb://127.0.0.1:27017/project_one

# Admin password. Quote it if it contains special characters.
ADMIN_PASSWORD="change-me"
# Optional instead of ADMIN_PASSWORD: a bcrypt hash of the password
# (generate with: npm run hash-password -- "your-password")
# ADMIN_PASSWORD_HASH=

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

SESSION_MAX_AGE_HOURS=8
COOKIE_SECURE=false
